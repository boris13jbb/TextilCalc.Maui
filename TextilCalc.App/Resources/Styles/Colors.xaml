<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand and semantic colors: the single source of truth for every screen. -->
    <Color x:Key="Primary">#5B21B6</Color>
    <Color x:Key="PrimaryGradient">#7C3AED</Color>
    <Color x:Key="PrimaryDark">#C4B5FD</Color>
    <Color x:Key="PrimaryDarkText">#2E1065</Color>
    <Color x:Key="PrimarySoft">#F1EAFE</Color>
    <Color x:Key="PrimarySoftDark">#2E1065</Color>
    <Color x:Key="Secondary">#0F9488</Color>
    <Color x:Key="SecondarySoft">#E8F8F5</Color>
    <Color x:Key="SecondarySoftDark">#042F2E</Color>
    <Color x:Key="SecondaryDarkText">#5EEAD4</Color>
    <Color x:Key="Tertiary">#3977F6</Color>
    <Color x:Key="TertiarySoft">#EAF1FF</Color>
    <Color x:Key="TertiarySoftDark">#1E3A5F</Color>
    <Color x:Key="Error">#D7483F</Color>
    <Color x:Key="ErrorSoft">#FEF3F2</Color>
    <Color x:Key="ErrorSoftDark">#3B1114</Color>
    <Color x:Key="Success">#15A879</Color>
    <Color x:Key="SuccessSoft">#ECFDF5</Color>
    <Color x:Key="SuccessSoftDark">#052E2B</Color>
    <Color x:Key="StatusOnline">#22C55E</Color>
    <Color x:Key="PageBackground">#F6F7FB</Color>
    <Color x:Key="PageBackgroundDark">#0F172A</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#111827</Color>
    <Color x:Key="SurfaceMuted">#F8FAFC</Color>
    <Color x:Key="SurfaceMutedDark">#1E293B</Color>
    <Color x:Key="SurfaceVariant">#F1EAFE</Color>
    <Color x:Key="TextPrimary">#182033</Color>
    <Color x:Key="TextSecondary">#6E7891</Color>
    <Color x:Key="TextTertiary">#94A3B8</Color>
    <Color x:Key="Border">#E7E9F1</Color>
    <Color x:Key="BorderDark">#334155</Color>
    <Color x:Key="Divider">#F1F5F9</Color>
    <Color x:Key="DividerDark">#1E293B</Color>
    <Color x:Key="IconBlue">#3977F6</Color>
    <Color x:Key="IconTeal">#0F9488</Color>
    <Color x:Key="IconSlate">#64748B</Color>
    <Color x:Key="IconIndigo">#5B21B6</Color>
    <Color x:Key="SidebarBackground">#5B21B6</Color>
    <Color x:Key="SidebarBackgroundDark">#1E1B4B</Color>
    <Color x:Key="SidebarItemActive">#7C3AED</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TextilCalc.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TextilCalc.App.ViewModels"
    x:DataType="vm:HomeViewModel"
    Title="Inicio">
    <ScrollView HorizontalOptions="Fill">
        <VerticalStackLayout
            Padding="{OnIdiom Phone='18,22,18,36', Tablet='32,30,32,44', Desktop='48,38,48,52'}"
            Spacing="18"
            MaximumWidthRequest="860"
            HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="5">
                <Label Text="TextilCalc" Style="{StaticResource PageTitle}" />
                <Label
                    Text="Herramientas precisas para tu operación textil"
                    Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <Border
                Style="{StaticResource TextilCard}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}"
                Stroke="{StaticResource Primary}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource Primary}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14">
                        <Label
                            Text="TC"
                            TextColor="White"
                            FontFamily="OpenSansSemibold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Panel de trabajo" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="Selecciona una herramienta para comenzar."
                            Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Herramientas" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />

            <VerticalStackLayout Spacing="12">
                <Border Style="{StaticResource TextilCard}" Padding="16" SemanticProperties.Description="Calcular gramatura. Obtén GSM, área y rendimiento de una pieza.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenGramaturaCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                            <Label Text="G" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Calcular gramatura" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <Label Text="Obtén GSM, área y rendimiento de una pieza." Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource TextilCard}" Padding="16" SemanticProperties.Description="Calcular metraje. Convierte peso, gramatura y ancho en metros.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMetrajeCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSoft}, Dark={StaticResource SuccessSoftDark}}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                            <Label Text="M" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Secondary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Calcular metraje" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <Label Text="Convierte peso, gramatura y ancho en metros." Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource TextilCard}" Padding="16" SemanticProperties.Description="Gestión de telas. Administra el catálogo e importa o exporta Excel.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTelasCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                            <Label Text="T" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Tertiary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Gestión de telas" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <Label Text="Administra el catálogo e importa o exporta Excel." Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource TextilCard}" Padding="16" SemanticProperties.Description="Calculadora científica. Realiza operaciones básicas y avanzadas.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCalculatorCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                            <Label Text="∑" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Calculadora científica" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <Label Text="Realiza operaciones básicas y avanzadas." Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Button
                Margin="0,10,0,0"
                Text="Salir de la aplicación"
                Command="{Binding ExitCommand}"
                Style="{StaticResource DangerAction}"
                HorizontalOptions="Start"
                SemanticProperties.Hint="Cierra TextilCalc" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TextilCalc.App.Views.TelasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TextilCalc.App.Models"
    xmlns:vm="clr-namespace:TextilCalc.App.ViewModels"
    x:DataType="vm:TelasViewModel"
    Title="Gestión de telas">
    <ScrollView>
        <VerticalStackLayout
            Padding="{OnIdiom Phone='16,16,16,36', Desktop='40,28'}"
            Spacing="14"
            MaximumWidthRequest="1000"
            HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <SearchBar
                    Placeholder="Buscar tela por nombre"
                    Text="{Binding SearchQuery}" />
                <Button
                    Grid.Column="1"
                    Text="+ Agregar"
                    Command="{Binding ShowAddFormCommand}"
                    BackgroundColor="{StaticResource Tertiary}" />
            </Grid>

            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="{StaticResource Error}" FontAttributes="Bold" />
            <Label Text="{Binding SuccessMessage}" IsVisible="{Binding HasSuccess}" TextColor="{StaticResource Success}" FontAttributes="Bold" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Border IsVisible="{Binding IsFormVisible}" Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding FormTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Tertiary}" />
                    <Label Text="Nombre" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding FormNombre}" Placeholder="Nombre de la tela" />
                    </Border>
                    <Label Text="Gramatura" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding FormGramatura}" Keyboard="Numeric" />
                    </Border>
                    <Label Text="Ancho (m), opcional" />
                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding FormAncho}" Keyboard="Numeric" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Guardar" Command="{Binding SaveTelaCommand}" />
                        <Button Grid.Column="1" Text="Cancelar" Command="{Binding CancelFormCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <CollectionView
                ItemsSource="{Binding Telas}"
                SelectedItem="{Binding SelectedTela}"
                SelectionMode="Single"
                HeightRequest="{OnIdiom Phone=300, Desktop=390}"
                EmptyView="No hay telas registradas.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Tela">
                        <Border Margin="0,3" Padding="12" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label FontSize="12" TextColor="{StaticResource Gray500}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Gramatura: " />
                                                <Span Text="{Binding Gramatura, StringFormat='{0:0.##}'}" />
                                                <Span Text=" · Ancho: " />
                                                <Span Text="{Binding Ancho, StringFormat='{0:0.##}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Editar"
                                    Padding="10,6"
                                    Command="{Binding ShowEditFormCommand, Source={RelativeSource AncestorType={x:Type vm:TelasViewModel}}, x:DataType=vm:TelasViewModel}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource Secondary}" />
                                <Button
                                    Grid.Column="2"
                                    Text="Eliminar"
                                    Padding="10,6"
                                    Command="{Binding DeleteTelaCommand, Source={RelativeSource AncestorType={x:Type vm:TelasViewModel}}, x:DataType=vm:TelasViewModel}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource Error}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="CÁLCULO DE METRAJE" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label
                        IsVisible="{Binding HasSelection}"
                        Text="{Binding SelectedTela.Nombre, StringFormat='Tela seleccionada: {0}'}"
                        FontAttributes="Bold" />
                    <Label
                        IsVisible="{Binding HasSelection}"
                        Text="{Binding SelectedTela.Gramatura, StringFormat='Gramatura: {0:0.##}'}" />
                    <Label
                        IsVisible="{Binding HasSelection}"
                        Text="{Binding SelectedTela.Ancho, StringFormat='Ancho: {0:0.##} m'}" />
                    <Label
                        IsVisible="{Binding HasNoSelection}"
                        Text="Seleccione una tela de la lista." />
                    <Border IsVisible="{Binding HasSelection}" Style="{StaticResource InputBorderStyle}">
                        <Entry Text="{Binding PesoBalanza}" Keyboard="Numeric" Placeholder="Peso de balanza (kg)" />
                    </Border>
                    <Button
                        IsVisible="{Binding HasSelection}"
                        Text="Calcular metraje"
                        Command="{Binding CalculateMetrajeCommand}" />
                    <Label
                        IsVisible="{Binding HasCalculatedMetraje}"
                        Text="{Binding MetrajeDisplay, StringFormat='Metraje calculado: {0} metros'}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="GESTIÓN DE DATOS" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Exportar Excel" Command="{Binding ExportCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <Button Grid.Column="1" Text="Importar Excel" Command="{Binding ImportCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="{StaticResource Secondary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Volver" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="1" Text="Calculadora" Command="{Binding OpenCalculatorCommand}" BackgroundColor="{StaticResource Tertiary}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
